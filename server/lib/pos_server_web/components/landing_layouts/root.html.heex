<!DOCTYPE html>
<html lang="es-DO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>tigoo</title>
    <meta name="description" content="Ventas, inventario y facturación electrónica para negocios que quieren avanzar." />
    <link rel="canonical" href="https://tigoo.app" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tigoo" />
    <meta property="og:title" content="tigoo" />
    <meta property="og:description" content="Ventas, inventario y facturación electrónica desde una sola solución." />
    <meta property="og:url" content="https://tigoo.app" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="tigoo" />
    <meta name="twitter:description" content="Ventas, inventario y facturación electrónica desde una sola solución." />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="preload" href={~p"/landing/fonts/inter-latin-variable.woff2"} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={~p"/landing/landing.css"} />
    <script defer src={~p"/landing/landing.js"}></script>
  </head>
  <body class="landing-page-body">
    {@inner_content}
  </body>
</html>
