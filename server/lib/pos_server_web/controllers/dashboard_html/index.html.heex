<main class="admin-page" aria-labelledby="dashboard-title">
  <header class="admin-topbar account-topbar">
    <a class="brand" href={~p"/dash"}>
      <span class="brand-mark" aria-hidden="true">R</span>
      <span>retaily</span>
    </a>
  </header>

  <section class="admin-content">
    <div class="dashboard-heading">
      <div>
        <p class="eyebrow"><span aria-hidden="true"></span> Account</p>
        <h1 id="dashboard-title">Welcome back, <%= @user.name %></h1>
        <p>Your account confirmation status.</p>
      </div>
    </div>

    <section class="card account-status-card" aria-labelledby="account-status-title">
      <div class="card-header">
        <p class="card-description">Account status</p>
        <h2 class="card-title" id="account-status-title"><%= if @user.confirmed_at, do: "Confirmed", else: "Awaiting confirmation" %></h2>
      </div>
      <div class="card-content">
        <div :if={is_nil(@user.confirmed_at)} class="alert" role="alert">
          <svg class="alert-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
          <div class="alert-content"><h3 class="alert-title">Confirmation pending</h3><p class="alert-description">Your account is awaiting confirmation from an administrator.</p></div>
        </div>
        <div :if={@user.confirmed_at} class="alert" role="status">
          <svg class="alert-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>
          <div class="alert-content"><h3 class="alert-title">Your account is confirmed</h3><p class="alert-description">Your account has been confirmed by an administrator.</p></div>
        </div>
      </div>
    </section>

    <section :if={@user.confirmed_at && is_nil(@user.tenant)} class="card tenant-setup-card" aria-labelledby="tenant-setup-title">
      <div class="card-header">
        <h2 class="card-title" id="tenant-setup-title">Create your workspace</h2>
        <p class="card-description">Choose a company name and permanent workspace ID.</p>
      </div>
      <form class="card-content" action={~p"/dash/tenant"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <div class="form-grid tenant-setup-grid">
          <div class="form-field" data-invalid={@company_form[:company_name].errors != [] || nil}>
            <label class="label" for={@company_form[:company_name].id}>Company name</label>
            <input class="input" id={@company_form[:company_name].id} name={@company_form[:company_name].name} type="text" value={@company_form[:company_name].value} required aria-invalid={if @company_form[:company_name].errors == [], do: "false", else: "true"} />
            <p :for={{message, _} <- @company_form[:company_name].errors} class="field-error" role="alert"><%= message %></p>
          </div>
          <div class="form-field" data-invalid={@tenant_form[:tenant].errors != [] || nil}>
            <label class="label" for={@tenant_form[:tenant].id}>Workspace ID</label>
            <input class="input" id={@tenant_form[:tenant].id} name={@tenant_form[:tenant].name} type="text" value={@tenant_form[:tenant].value} required autocomplete="off" aria-describedby="tenant-help" aria-invalid={if @tenant_form[:tenant].errors == [], do: "false", else: "true"} />
            <p class="field-description" id="tenant-help">Lowercase letters, numbers, and underscores only.</p>
            <p :for={{message, _} <- @tenant_form[:tenant].errors} class="field-error" role="alert"><%= message %></p>
          </div>
          <div class="form-field">
            <label class="label" for={@company_form[:rnc].id}>RNC <span aria-hidden="true">(optional)</span></label>
            <input class="input" id={@company_form[:rnc].id} name={@company_form[:rnc].name} type="text" value={@company_form[:rnc].value} />
          </div>
        </div>
        <div class="form-actions tenant-setup-actions"><button class="btn" data-variant="default" type="submit">Create workspace</button></div>
      </form>
    </section>

    <section :if={@company} class="card tenant-summary-card" aria-labelledby="workspace-summary-title">
      <div class="card-header">
        <p class="card-description">Workspace</p>
        <h2 class="card-title" id="workspace-summary-title"><%= @company.company_name %></h2>
      </div>
      <div class="card-content tenant-summary-grid">
        <div><p class="tenant-summary-label">Workspace ID</p><p class="tenant-summary-value"><%= @user.tenant %></p></div>
        <div><p class="tenant-summary-label">RNC</p><p class="tenant-summary-value"><%= @company.rnc || "Not provided" %></p></div>
      </div>
    </section>
  </section>
</main>
