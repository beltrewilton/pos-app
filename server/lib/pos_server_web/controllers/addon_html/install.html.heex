<main class="dashboard-shell" aria-labelledby="addons-title">
  <.dashboard_sidebar active={:addons} tenant={@tenant} />
  <div class="dashboard-main">
    <header class="dashboard-header"><div><p class="dashboard-kicker">Extensions</p><h1 id="addons-title">Apps</h1></div></header>
    <div class="dashboard-content">
      <section class="addons-catalog" aria-labelledby="catalog-title">
        <div class="addons-catalog-heading">
          <div>
            <h2 id="catalog-title">Available apps</h2>
            <p>Extend your workspace with server-managed business tools.</p>
          </div>
          <span class="addons-count"><%= length(@catalog) %> available</span>
        </div>
        <div class="addons-grid">
          <article :for={addon <- @catalog} class="card addon-card">
            <div class="card-header addon-card-header">
              <span class="addon-icon" aria-hidden="true"><%= addon.icon %></span>
              <div>
                <h3 class="card-title"><%= addon.name %></h3>
                <p class="addon-technical-name"><%= addon.identifier %></p>
              </div>
              <span :if={Enum.any?(@installed, &(&1.identifier == addon.identifier))} class="addon-installed">Installed</span>
            </div>
            <div class="card-content addon-card-content"><p><%= addon.description %></p></div>
            <div class="card-footer addon-card-footer">
              <form :if={not Enum.any?(@installed, &(&1.identifier == addon.identifier))} action={~p"/addons/install"} method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="identifier" value={addon.identifier} />
                <button class="btn" data-variant="default" data-size="sm" type="submit">Install</button>
              </form>
              <form :if={Enum.any?(@installed, &(&1.identifier == addon.identifier))} action={"/addons/#{addon.identifier}/uninstall"} method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button class="btn" data-variant="outline" data-size="sm" type="submit">Uninstall</button>
              </form>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>
</main>
