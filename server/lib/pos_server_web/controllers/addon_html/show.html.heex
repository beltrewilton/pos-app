<main class="dashboard-shell" aria-labelledby="addon-title">
  <.dashboard_sidebar active={@addon.identifier} />
  <div class="dashboard-main">
    <header class="dashboard-header"><div><p class="dashboard-kicker">Addon</p><h1 id="addon-title"><%= @page.title %></h1></div></header>
    <div class="dashboard-content"><section class="card dashboard-panel"><div class="card-content"><p><%= @page.message %></p></div></section></div>
  </div>
</main>
