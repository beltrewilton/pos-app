<.pos_layout
  id="installed-addons-page"
  class="pos-shell invoice-view"
  active_page={:installed_addons}
  scope={@scope}
  stores={@stores}
  store_id={@store_id}
  aria-labelledby="installed-addons-title"
>
  <section class="catalog-panel">
    <header class="dashboard-header">
      <div>
        <p class="dashboard-kicker" data-i18n="addons.extensions">Extensions</p>
        <h1 id="installed-addons-title" data-i18n="addons.installedAddons">Installed Add-ons</h1>
      </div>
    </header>
    <div class="dashboard-content">
      <section class="addons-catalog" aria-labelledby="installed-catalog-title">
        <div class="addons-catalog-heading">
          <div>
            <h2 id="installed-catalog-title" data-i18n="addons.installed">Installed</h2>
            <p data-i18n="addons.installedCopy">Open the add-ons currently enabled for this workspace.</p>
          </div>
          <span class="addons-count">{length(@installed)} <span data-i18n="addons.installed">installed</span></span>
        </div>

        <div :if={@installed != []} class="installed-addons-grid">
          <a :for={addon <- @installed} class="installed-addon-card" href={"/pos/addons/#{addon.identifier}"}>
            <span class="addon-icon installed-addon-icon" aria-hidden="true">{addon.icon}</span>
            <span class="installed-addon-name">{addon.name}</span>
          </a>
        </div>

        <div :if={@installed == []} class="card dashboard-panel">
          <div class="card-header">
            <h2 class="card-title" data-i18n="addons.noInstalledAddons">No add-ons installed</h2>
            <p class="card-description" data-i18n="addons.noInstalledAddonsCopy">
              Install add-ons from the app catalog to access them here.
            </p>
          </div>
          <div :if={PosServer.Accounts.Scope.allowed?(@scope, "pos.addons.install")} class="card-footer">
            <a class="btn" data-variant="default" href={~p"/pos/addons/install"}>
              <span data-i18n="dashboard.installAddon">Install Addons</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </section>
</.pos_layout>
