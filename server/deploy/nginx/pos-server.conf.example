# Copy this file to /etc/nginx/conf.d/pos-server.conf.

server {
    listen 80;
    listen [::]:80;
    server_name tigoo.app;

    access_log /var/log/nginx/pos-server.access.log;
    error_log  /var/log/nginx/pos-server.error.log;

    location / {
        # Phoenix's production default is PORT=4000.
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Needed for Phoenix LiveView/WebSocket connections.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
