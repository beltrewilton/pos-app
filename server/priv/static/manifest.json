{
  "name": "tigoo POS",
  "short_name": "tigoo",
  "description": "tigoo POS LiveView",

  "id": "/pos",
  "start_url": "/pos",
  "scope": "/pos",

  "display": "standalone",

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "background_color": "#f8fafc",
  "theme_color": "#088674",

  "icons": [
    {
      "src": "/pwa/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/pwa/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/pwa/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/pwa/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
